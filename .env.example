# Visual Arc — real numbers configuration
# Copy this file to .env and fill in ONE provider (Twilio is easiest to start).

# ===== OPTION A: TWILIO (recommended to start) =====
# https://console.twilio.com → Dashboard → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# ===== OPTION B: TELNYX (cheaper at scale) =====
# https://portal.telnyx.com → API Keys
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxx
# Optional but recommended:
# TELNYX_CONNECTION_ID=
# TELNYX_MESSAGING_PROFILE_ID=

# Public URL of this server (for SMS webhooks).
# Leave empty on the Arena preview — it is detected automatically.
# PUBLIC_BASE_URL=https://your-domain.com

# ===== BUSINESS SETTINGS =====
# Admin panel key (open /admin) — CHANGE THIS!
ADMIN_KEY=change-me-strong-key
# Bonus credits (KSh) new users get on signup (0 = none)
SIGNUP_BONUS=0
# Your USDT TRC-20 wallet address for customer top-ups
USDT_ADDRESS=
